page { background: #f3f5f8; color: #1f2937; font-size: 30rpx; }
.page { padding: 24rpx 24rpx 160rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; }
.plate { font-size: 36rpx; font-weight: 700; }
.sub { color: #6b7280; font-size: 26rpx; margin-top: 8rpx; line-height: 1.45; }
.row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.tag { font-size: 24rpx; color: #1d4ed8; background: #eff6ff; border-radius: 999rpx; padding: 6rpx 16rpx; }
.tag.wait { color: #9a3412; background: #ffedd5; }
.tag.work { color: #166534; background: #dcfce7; }
.tag.done { color: #4b5563; background: #e5e7eb; }
.toast { background: #eff6ff; color: #1e3a8a; border-radius: 16rpx; padding: 20rpx; margin-bottom: 20rpx; font-size: 26rpx; line-height: 1.5; }
.filters { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.chip { background: #fff; border-radius: 999rpx; padding: 12rpx 24rpx; font-size: 26rpx; color: #374151; }
.chip.on { background: #1a2332; color: #fff; }
.hero { background: #1a2332; color: #fff; border-radius: 24rpx; padding: 36rpx 32rpx; margin-bottom: 20rpx; }
.kicker { font-size: 24rpx; color: #93c5fd; }
.big { font-size: 44rpx; font-weight: 700; line-height: 1.35; margin: 16rpx 0 28rpx; }
.where { display: flex; gap: 16rpx; }
.where-box { flex: 1; background: #243044; border-radius: 16rpx; padding: 20rpx; }
.where-label { font-size: 22rpx; color: #93c5fd; }
.where-value { font-size: 40rpx; font-weight: 700; margin-top: 6rpx; }
.queue-line { margin-top: 24rpx; font-size: 28rpx; color: #dbeafe; }
.steps { display: flex; flex-wrap: wrap; gap: 10rpx; }
.step { font-size: 24rpx; padding: 8rpx 14rpx; border-radius: 999rpx; background: #e5e7eb; color: #6b7280; }
.step.now { background: #2f6fed; color: #fff; }
.step.done { background: #dcfce7; color: #166534; }
.h2 { font-size: 32rpx; font-weight: 700; margin-bottom: 8rpx; }
.note { color: #6b7280; font-size: 26rpx; line-height: 1.5; }
.field { display: flex; justify-content: space-between; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid #e5e7eb; font-size: 28rpx; }
.field text:last-child { text-align: right; }
button.act { margin: 0 0 16rpx; background: #2f6fed; color: #fff; border-radius: 16rpx; font-size: 32rpx; line-height: 88rpx; height: 88rpx; }
button.act.ghost { background: #fff; color: #1d4ed8; border: 1rpx solid #bfdbfe; }
button.act::after { border: none; }
.track { height: 16rpx; background: #e5e7eb; border-radius: 99rpx; overflow: hidden; margin-top: 12rpx; }
.fill { height: 100%; background: #22c55e; }
.fill.low { background: #ef4444; }
.cars { white-space: nowrap; width: 100%; margin-bottom: 20rpx; }
.car { display: inline-block; margin-right: 12rpx; background: #fff; border-radius: 999rpx; padding: 12rpx 20rpx; font-size: 26rpx; }
.car.on { background: #2f6fed; color: #fff; }
.level-num { font-size: 40rpx; font-weight: 700; }
