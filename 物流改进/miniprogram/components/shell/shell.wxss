:host { display: block; min-height: 100%; }
.app { display: flex; align-items: stretch; min-height: 100vh; background: #f3f5f8; }
.side { width: 300rpx; background: #1a2332; color: #d5deea; flex: none; position: sticky; top: 0; height: 100vh; overflow-y: auto; box-sizing: border-box; }
.logo { padding: 28rpx 16rpx 12rpx; color: #fff; font-weight: 700; font-size: 28rpx; }
.role { margin: 8rpx 12rpx 16rpx; background: #243044; border-radius: 12rpx; padding: 12rpx; font-size: 22rpx; }
.role-name { display: block; color: #fff; margin-top: 4rpx; }
.group { padding: 8rpx 16rpx; font-size: 22rpx; color: #8ea0b5; }
.item { margin: 4rpx 10rpx; padding: 14rpx 12rpx; border-radius: 12rpx; font-size: 22rpx; line-height: 1.35; }
.item.on { background: #2f6fed; color: #fff; }
.main { flex: 1; min-width: 0; }
.bar { height: 88rpx; background: #fff; border-bottom: 1rpx solid #e5e7eb; display: flex; align-items: center; justify-content: space-between; padding: 0 20rpx; }
.crumb { color: #1f2937; font-size: 26rpx; }
.role-btn { color: #2563eb; font-size: 24rpx; }
.content { padding: 20rpx; }
.toast { background: #eff6ff; border: 1rpx solid #bfdbfe; color: #1e3a8a; border-radius: 12rpx; padding: 16rpx; margin-bottom: 16rpx; font-size: 24rpx; line-height: 1.5; }
