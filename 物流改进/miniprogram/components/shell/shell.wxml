<view class="app">
  <view class="side">
    <view class="logo">溶剂物流系统</view>
    <view class="role">当前身份
      <text class="role-name">{{role}}</text>
    </view>
    <view class="group">溶剂需求计划</view>
    <view
      wx:for="{{pages}}"
      wx:key="id"
      class="item {{current === item.id ? 'on' : ''}}"
      data-url="{{item.url}}"
      bindtap="go"
    >{{item.title}}</view>
  </view>
  <view class="main">
    <view class="bar">
      <text class="crumb">首页 / {{title}}</text>
      <text class="role-btn" bindtap="toggleRole">切换角色</text>
    </view>
    <view class="content">
      <view class="toast" wx:if="{{toast}}">{{toast}}</view>
      <slot></slot>
    </view>
  </view>
</view>
