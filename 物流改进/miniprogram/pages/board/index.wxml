<shell current="board" title="进度与周计划" toast="{{toast}}" role="{{role}}" bind:rolechange="onRole">
  <view class="kpi">
    <view class="kpi-card"><view class="kpi-label">本周溶剂需求</view><view class="kpi-num">{{total}} 吨</view><view class="delta">批次合计 {{batchTotal}} 吨</view></view>
    <view class="kpi-card"><view class="kpi-label">进行中</view><view class="kpi-num">{{running}}</view><view class="delta">看板抓取的进度</view></view>
  </view>
  <view class="kpi">
    <view class="kpi-card"><view class="kpi-label">延误批次</view><view class="kpi-num">{{late}}</view><view class="delta down">开工已过仍未开始</view></view>
    <view class="kpi-card"><view class="kpi-label">周计划与批次差</view><view class="kpi-num">{{diff}}</view><view class="delta">改周计划后应回到 0</view></view>
  </view>
  <view class="card">
    <view class="h2">周计划 · 可直接改</view>
    <view class="note">改这一列，上面的合计和小时需求一起变。余量仍是 DCS 演示值。</view>
    <view class="row row-h"><text>项目</text><text>溶剂</text><text>周计划</text><text>进度</text></view>
    <view class="row" wx:for="{{weeks}}" wx:key="id">
      <text>{{item.project}}</text>
      <text>{{item.solvent}}</text>
      <input class="num" type="digit" value="{{item.weekQty}}" data-id="{{item.id}}" bindblur="onQty" />
      <view class="track"><view class="fill {{item.low ? 'low' : ''}}" style="width: {{item.pct}}%;"></view></view>
    </view>
  </view>
  <view class="card">
    <view class="h2">当前批次进度</view>
    <view class="row" wx:for="{{progress}}" wx:key="id">
      <view>
        <view>{{item.title}} · {{item.solvent}} {{item.qty}} 吨</view>
        <view class="note">{{item.statusText}}</view>
      </view>
      <view class="track"><view class="fill {{item.slip ? 'low' : ''}}" style="width: {{item.pct}}%;"></view></view>
    </view>
  </view>
  <view class="card">
    <view class="h2">溶剂与库存</view>
    <view class="row row-h"><text>溶剂</text><text>余量</text><text>周需求</text><text>液位</text></view>
    <view class="row" wx:for="{{stocks}}" wx:key="name">
      <text>{{item.name}}</text>
      <text>{{item.qty}}</text>
      <text>{{item.week}}</text>
      <view class="track"><view class="fill {{item.low ? 'low' : ''}}" style="width: {{item.level}}%;"></view></view>
    </view>
  </view>
</shell>
