<chrome current="queue" role="{{role}}">
  <view class="page">
    <view class="toast" wx:if="{{toast}}">{{toast}}</view>
    <view class="filters">
      <view class="chip {{filter === '全部' ? 'on' : ''}}" data-filter="全部" bindtap="onFilter">全部</view>
      <view class="chip {{filter === '入库' ? 'on' : ''}}" data-filter="入库" bindtap="onFilter">入库</view>
      <view class="chip {{filter === '出库' ? 'on' : ''}}" data-filter="出库" bindtap="onFilter">出库</view>
    </view>
    <view class="card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpen">
      <view class="row">
        <text class="plate">{{item.plate}}</text>
        <text class="tag {{item.tag}}">{{item.status}}</text>
      </view>
      <view class="sub">{{item.kind}} · {{item.material}} {{item.qty}} 吨</view>
      <view class="sub">{{item.bay}} · {{item.tank}} · 计划 {{item.planTime}}</view>
      <view class="sub">{{item.queueText}}</view>
    </view>
  </view>
</chrome>
