<shell current="demand" title="更新溶剂需求" toast="{{toast}}" role="{{role}}" bind:rolechange="onRole">
  <view class="kpi">
    <view class="kpi-card">
      <view class="kpi-label">周计划合计</view>
      <view class="kpi-num">{{total}} 吨</view>
      <view class="delta">改任意一行，看板使用同一个数</view>
    </view>
  </view>
  <view class="card">
    <view class="h2">本周溶剂需求</view>
    <view class="note">生产经理维护各项目的周计划。未完成批次按比例跟着变，进度看板和小时需求立刻用新数。</view>
    <view class="row row-h"><text>项目</text><text>溶剂</text><text>周计划</text><text>已分摊</text></view>
    <view class="row" wx:for="{{rows}}" wx:key="id">
      <text>{{item.project}}</text>
      <text>{{item.solvent}}</text>
      <input class="num" type="digit" value="{{item.weekQty}}" data-id="{{item.id}}" bindblur="onQty" />
      <text>{{item.batchQty}}</text>
    </view>
  </view>
</shell>
