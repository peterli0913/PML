<shell current="demand" title="更新溶剂需求" toast="{{toast}}" role="{{role}}" bind:rolechange="onRole">
  <view class="kpi">
    <view class="kpi-card">
      <view class="kpi-label">周计划合计</view>
      <view class="kpi-num">{{total}} 吨</view>
      <view class="delta">改任意一行，看板使用同一个数</view>
    </view>
  </view>
  <view class="card">
    <view class="h2">本周溶剂需求</view>
    <view class="note">生产经理维护各项目的周计划。未完成批次按比例跟着变，进度看板和小时需求立刻用新数。</view>
    <view class="demand-row" wx:for="{{rows}}" wx:key="id">
      <view class="grow">
        <view>{{item.project}} · {{item.solvent}}</view>
        <view class="note">{{item.workshop}} · {{item.materialCode}} · {{item.manager}} · 已分摊 {{item.batchQty}} 吨</view>
      </view>
      <input class="num" type="digit" value="{{item.weekQty}}" data-id="{{item.id}}" disabled="{{!canEdit}}" bindblur="onQty" />
    </view>
  </view>
</shell>
