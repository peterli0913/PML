<chrome current="bays" role="{{role}}">
  <view class="page">
    <view class="toast" wx:if="{{toast}}">{{toast}}</view>
    <view class="card" wx:for="{{rows}}" wx:key="id">
      <view class="row">
        <text class="plate">{{item.name}}</text>
        <text class="tag {{item.occupant ? 'work' : 'done'}}">{{item.occupant ? '占用' : '空闲'}}</text>
      </view>
      <view class="sub">{{item.material}} · {{item.tank}}</view>
      <view class="sub">{{item.occupant ? item.occupant + ' · ' + item.orderId : '没有车在作业'}}</view>
    </view>
  </view>
</chrome>
