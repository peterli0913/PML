<chrome current="driver" role="{{role}}">
  <view class="page">
    <view class="note">演示可切换工单。正式环境司机只看见发给自己的一张。</view>
    <scroll-view class="cars" scroll-x>
      <view wx:for="{{cars}}" wx:key="id" class="car {{item.on ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onCar">{{item.id}} {{item.plate}}</view>
    </scroll-view>
    <view class="hero">
      <view class="kicker">当前指令 · {{current.plate}}</view>
      <view class="big">{{current.instruction}}</view>
      <view class="where" wx:if="{{current.showWhere}}">
        <view class="where-box">
          <view class="where-label">现在去 · 鹤位</view>
          <view class="where-value">{{current.bay}}</view>
        </view>
        <view class="where-box">
          <view class="where-label">储罐</view>
          <view class="where-value">{{current.tank}}</view>
        </view>
      </view>
      <view class="queue-line">{{current.material}} {{current.qty}} 吨</view>
    </view>
    <button wx:if="{{current.canConfirm}}" class="act" bindtap="onConfirm">确认这辆车</button>
  </view>
</chrome>
