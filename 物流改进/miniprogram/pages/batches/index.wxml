<shell current="batches" title="更新批次清单" toast="{{toast}}" role="{{role}}" bind:rolechange="onRole">
  <view class="card">
    <view class="h2">单批次清单</view>
    <view class="note">改需求量会回写周计划。距开始填负数表示计划时点已过、批次还没开工。进度填 0 到 1。</view>
    <view class="batch" wx:for="{{rows}}" wx:key="id">
      <view class="batch-title">{{item.project}} {{item.opNo}} · {{item.solvent}}</view>
      <view class="note">{{item.step}} · {{item.manager}} · {{item.workshop}} · {{item.mode}} · {{item.status}}</view>
      <view class="fields">
        <view>需求量<input class="num" type="digit" value="{{item.qty}}" data-id="{{item.id}}" data-field="qty" disabled="{{!canEdit}}" bindblur="onField" /></view>
        <view>距开始<input class="num" type="text" value="{{item.plannedStartHour}}" data-id="{{item.id}}" data-field="plannedStartHour" disabled="{{!canEdit}}" bindblur="onField" /></view>
        <view>时长<input class="num" type="digit" value="{{item.durationHours}}" data-id="{{item.id}}" data-field="durationHours" disabled="{{!canEdit}}" bindblur="onField" /></view>
        <view>进度<input class="num" type="digit" value="{{item.progress}}" data-id="{{item.id}}" data-field="progress" disabled="{{!canEdit}}" bindblur="onField" /></view>
      </view>
    </view>
  </view>
</shell>
