<shell current="hourly" title="未来一周小时需求" toast="{{toast}}" role="{{role}}" bind:rolechange="onRole">
  <view class="pills">
    <view wx:for="{{pills}}" wx:key="name" class="pill {{item.on ? 'on' : ''}}" data-name="{{item.name}}" bindtap="onSolvent">{{item.name}} · {{item.mark}}</view>
    <view class="pill on" bindtap="onFreeze">执行 12 小时重算</view>
  </view>
  <view class="card">
    <view class="h2">{{solvent}} · 未来 168 小时</view>
    <view class="samples">
      <view wx:for="{{samples}}" wx:key="h" class="sample">
        <view class="sample-bar {{item.below ? 'low' : ''}}" style="height: {{item.height}}rpx;"></view>
      </view>
    </view>
    <view class="note">每 6 小时一根，柱高是预计库存。低于下限加缓冲 {{floor}} 吨时标红。</view>
    <view class="day" wx:for="{{days}}" wx:key="label">
      <view class="day-meta"><text>{{item.label}} · {{item.qty}} 吨</text><text>日末库存 {{item.end}}</text></view>
      <view class="track wide"><view class="fill" style="width: {{item.width}}%;"></view></view>
    </view>
  </view>
  <view class="card">
    <view class="h2">计算结果</view>
    <view class="kpi-num">{{suggestQty}} 吨</view>
    <view class="note">只按总量减库存是 {{legacyQty}} 吨。提前期 {{leadHours}} 小时。一周需求 {{totalDemand}} 吨，起始可用 {{startOnHand}} 吨。</view>
    <view class="alert bad" wx:if="{{urgent}}">第 {{stockoutHour}} 小时破下限加缓冲。车要第 {{leadHours}} 小时才到，需要加急或后移批次。</view>
    <view class="h2">到货更改</view>
    <view class="alert" wx:if="{{changeText}}">{{changeText}}</view>
    <view class="note" wx:else>和上一档 12 小时定稿比，没有超过 1 吨或 12 小时。</view>
    <view class="h2">延误</view>
    <view class="alert" wx:for="{{delays}}" wx:key="id">{{item.text}}</view>
    <view class="note" wx:if="{{!delays.length}}">没有超过 4 小时的开工延误。</view>
  </view>
</shell>
