<chrome current="tanks" role="{{role}}">
  <view class="page">
    <view class="toast" wx:if="{{toast}}">{{toast}}</view>
    <view class="card" wx:for="{{rows}}" wx:key="id">
      <view class="row">
        <view>
          <view class="plate">{{item.code}} · {{item.material}}</view>
          <view class="sub">{{item.bay}} · {{item.online ? '液位在线' : '液位中断'}}</view>
        </view>
        <view class="level-num">{{item.qty}} 吨</view>
      </view>
      <view class="track"><view class="fill {{item.level > 85 ? 'low' : ''}}" style="width: {{item.level}}%;"></view></view>
      <view class="sub">可用 {{item.free}} 吨 / 罐容 {{item.cap}} 吨</view>
      <view class="sub">批号 {{item.batch}}</view>
    </view>
  </view>
</chrome>
